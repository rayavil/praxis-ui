---
import Base from '../layouts/Base.astro';

const modules = import.meta.glob('/rules/*.md', { eager: true });

const rules = Object.entries(modules)
  .map(([path, mod]: [string, any]) => {
    const slug = path.split('/').pop()!.replace('.md', '');
    const headings = mod.getHeadings ? mod.getHeadings() : [];
    const h1 = headings.find((h: any) => h.depth === 1);
    return {
      slug,
      title: h1 ? h1.text : slug,
    };
  })
  .sort((a, b) => a.slug.localeCompare(b.slug));

const phases = [
  { n: 1, name: 'Diagnóstico de Usuario y Contexto', slug: '01-principios-ux' },
  { n: 2, name: 'Estructuración de Layout y Jerarquía', slug: '02-reglas-ui-vistas' },
  { n: 3, name: 'Aplicación de Patrones y Tendencias 2026', slug: '03-tendencias-2026' },
  { n: 4, name: 'Código Frontend e Implementación Limpia', slug: '04-frontend-tailwind' },
];
---

<Base title="Inicio" description="Base de conocimiento de diseño UI/UX y Skill consumible por IAs.">
  <section class="mb-14">
    <h1 class="text-4xl font-bold text-slate-900 mb-1">Praxis UI</h1>
    <p class="text-sm font-medium text-slate-400 uppercase tracking-wide mb-4">UI/UX Design Intelligence Hub</p>
    <p class="text-lg text-slate-600 max-w-2xl leading-relaxed">
      Base de conocimiento de diseño de interfaz, versionada y consultable, que además funciona como
      <em>Skill</em> consumible directamente por Claude, Cursor, Antigravity u otras IAs.
    </p>
    <a
      href={`${import.meta.env.BASE_URL}skill/`}
      class="inline-block mt-6 bg-slate-900 text-white px-5 py-2.5 rounded-md text-sm font-medium hover:bg-slate-700"
    >
      Ver SKILL.md — el orquestador
    </a>
  </section>

  <section class="mb-14">
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Flujo de 4 fases</h2>
    <ol class="grid sm:grid-cols-2 gap-4">
      {phases.map((phase) => (
        <li class="border border-slate-200 bg-white rounded-lg p-5">
          <a href={`${import.meta.env.BASE_URL}rules/${phase.slug}/`} class="block">
            <span class="text-xs font-semibold text-slate-400 uppercase tracking-wide">Fase {phase.n}</span>
            <p class="text-slate-900 font-medium mt-1">{phase.name}</p>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <section>
    <h2 class="text-xl font-semibold text-slate-900 mb-4">Reglas ({rules.length})</h2>
    <ul class="divide-y divide-slate-200 border border-slate-200 rounded-lg bg-white">
      {rules.map((rule) => (
        <li>
          <a
            href={`${import.meta.env.BASE_URL}rules/${rule.slug}/`}
            class="flex items-center justify-between px-5 py-4 hover:bg-slate-50"
          >
            <span class="text-slate-900">{rule.title}</span>
            <span class="text-slate-400 text-sm">{rule.slug}.md</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</Base>
